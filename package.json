{
  "name": "@item-enonic-types/lib-cvpartner",
  "version": "0.1.0",
  "description": "Type definitions for lib-cvpartner",
  "license": "MIT",
  "files": [
    "*.d.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node tsup/anyServerFiles.js && npx tsup -d build/resources/main",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "node tsup/anyServerFiles.js && npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "eslint --fix 'src/**/*.ts'",
    "release": "npm run build",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties",
    "prepublishOnly": "tsc --project src/main/resources/tsconfig.json --declarationDir build/types --emitDeclarationOnly true --declaration true && cp -r ./build/types/lib/cvpartner/* .",
    "postpublish": "rm ./*.d.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@enonic-types/core": "^7.15.1",
    "@enonic-types/global": "^7.15.1",
    "@enonic-types/lib-common": "^7.15.1",
    "@enonic-types/lib-event": "^7.15.1",
    "@enonic-types/lib-node": "^7.15.1",
    "@enonic-types/lib-repo": "^7.15.1",
    "@enonic-types/lib-task": "^7.15.1",
    "@item-enonic-types/global": "^7.15.0",
    "@item-enonic-types/lib-http-client": "^3.2.2",
    "@swc/core": "^1.11.29",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
